{
  "name": "martha-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build": "npm run env -s && ng build --prod",
    "start": "npm run env -s && ng serve",
    "start:local-proxy": "npm run env -s && ng serve --proxy-config proxy.conf.js",
    "serve:sw": "npm run build -s && npx http-server ./dist -p 4200",
    "lint": "ng lint && stylelint \"src/**/*.scss\" --syntax scss && htmlhint \"src\" --config .htmlhintrc",
    "test": "npm run env -s && ng test",
    "test:ci": "npm run env -s && npm run lint -s && ng test --configuration=ci",
    "e2e": "npm run env -s && ng e2e",
    "translations:extract": "ngx-translate-extract --input ./src --output ./src/translations/template.json --format=json --clean --sort --marker extract",
    "env": "ngx-scripts env npm_package_version APM_URL",
    "generate": "ng generate",
    "dev:ssr": "ng run martha-web:serve-ssr",
    "serve:ssr": "node dist/martha-web/server/main.js",
    "build:ssr": "ng build --prod && ng run martha-web:server:production",
    "prerender": "ng run martha-web:prerender"
  },
  "dependencies": {
    "@angular/animations": "^10.1.1",
    "@angular/cdk": "^10.2.1",
    "@angular/common": "^10.1.1",
    "@angular/compiler": "^10.1.1",
    "@angular/core": "^10.1.1",
    "@angular/flex-layout": "^10.0.0-beta.32",
    "@angular/forms": "^10.1.1",
    "@angular/google-maps": "^10.2.1",
    "@angular/material": "^10.2.1",
    "@angular/platform-browser": "^10.1.1",
    "@angular/platform-browser-dynamic": "^10.1.1",
    "@angular/platform-server": "^10.1.1",
    "@angular/router": "^10.1.1",
    "@angular/service-worker": "^10.1.1",
    "@elastic/apm-rum-angular": "^1.1.9",
    "@gdnnusantara/nusantara-web-lib": "0.0.1",
    "@ngrx/effects": "^10.0.0",
    "@ngrx/entity": "^10.0.0",
    "@ngrx/store": "^10.0.0",
    "@ngrx/store-devtools": "^10.0.0",
    "@nguniversal/express-engine": "^10.1.0",
    "@ngx-translate/core": "^13.0.0",
    "angularx-social-login": "~3.2.2",
    "dompurify": "^2.2.6",
    "express": "^4.17.1",
    "flickity": "^2.2.1",
    "imports-loader": "^1.1.0",
    "jquery": "^3.5.1",
    "material-design-icons-iconfont": "^6.1.0",
    "moment": "^2.28.0",
    "ngx-daterangepicker-material": "^4.0.1",
    "ngx-infinite-scroll": "^9.1.0",
    "ngx-sharebuttons": "^8.0.5",
    "ngx-slick-carousel": "^0.5.1",
    "ngx-youtube-player": "^9.1.0",
    "rxjs": "^6.6.3",
    "slick-carousel": "^1.8.1",
    "tslib": "^2.0.1",
    "zone.js": "~0.11.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.1001.1",
    "@angular/cli": "~10.1.1",
    "@angular/compiler-cli": "^10.1.1",
    "@angular/language-service": "^10.1.1",
    "@angularclass/hmr": "^3.0.0",
    "@auth0/angular-jwt": "^5.0.1",
    "@biesbjerg/ngx-translate-extract": "^7.0.2",
    "@ngrx/schematics": "^10.0.0",
    "@nguniversal/builders": "^10.1.0",
    "@ngx-rocket/scripts": "^4.0.0",
    "@types/express": "^4.17.8",
    "@types/googlemaps": "^3.40.3",
    "@types/jasmine": "^3.5.14",
    "@types/jasminewd2": "^2.0.8",
    "@types/node": "^14.10.2",
    "codelyzer": "^6.0.0",
    "htmlhint": "^0.14.1",
    "https-proxy-agent": "^5.0.0",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.2",
    "karma": "~5.2.2",
    "karma-chrome-launcher": "^3.1.0",
    "karma-cli": "~2.0.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "^4.0.1",
    "karma-jasmine-html-reporter": "^1.5.4",
    "karma-junit-reporter": "^2.0.1",
    "prettier": "2.2.1",
    "protractor": "~7.0.0",
    "puppeteer": "^5.3.0",
    "stylelint": "~13.7.1",
    "stylelint-config-recommended-scss": "~4.2.0",
    "stylelint-config-standard": "~20.0.0",
    "stylelint-scss": "~3.18.0",
    "ts-node": "^9.0.0",
    "tslint": "~6.1.3",
    "typescript": "~4.0.2"
  }
}
